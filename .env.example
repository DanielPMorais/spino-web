APP_NAME="Spino Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Caminho usado pelo Docker Compose. Para execução local sem Docker, use
# database/database.sqlite e crie o arquivo antes de migrar.
DB_DATABASE=/var/www/html/storage/app/spino.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Horários oficiais do edital de 2026, no fuso configurado pela aplicação.
COMPETITION_REGISTRATION_STARTS_AT="2026-10-05 00:00:00"
COMPETITION_REGISTRATION_ENDS_AT="2026-10-19 23:59:00"
COMPETITION_CONTACT_EMAIL=comissaopontedepalito@ifspcaraguatatuba.edu.br
COMPETITION_ADMIN_EMAILS=

# Use apenas em um deploy para criar a primeira conta do painel administrativo.
# O e-mail precisa também constar em COMPETITION_ADMIN_EMAILS. Remova a senha e
# altere BOOTSTRAP_ADMIN_ON_DEPLOY para false assim que a conta for criada.
BOOTSTRAP_ADMIN_ON_DEPLOY=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="Comissão organizadora"
BOOTSTRAP_ADMIN_PASSWORD=

# Use true only for one production deploy to remove all application data while
# preserving the migrations table. Remove it immediately after that deploy.
CLEAR_TEST_DATA_ON_DEPLOY=false

# Token enviado pelo Raspberry Pi no cabeçalho Authorization: Bearer <token>.
SENSORS_API_TOKEN=

# Docker Compose: por padrão, a aplicação só é exposta localmente para um proxy
# reverso (Nginx, Apache ou Caddy). O diretório data/ guarda o SQLite persistente.
SPINO_HTTP_BIND=127.0.0.1
SPINO_HTTP_PORT=8080
SPINO_DATA_PATH=./data
